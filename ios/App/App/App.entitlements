<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Links que abrem no app: tocar em https://futtyapp.com.br/s/… no WhatsApp abre o app e não o Safari. No iOS quem
	     diz os caminhos é o arquivo https://futtyapp.com.br/.well-known/apple-app-site-association, servido pelo site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:futtyapp.com.br</string>
	</array>
</dict>
</plist>
