<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 14-set (Android): retorno do login Google e dos links de e-mail
                 (recuperar senha) — com.futty.app://auth/callback. Capturado por
                 components/DeepLinkListener.jsx via App.addListener('appUrlOpen').
                 Mesmo host que lib/googleAuth.js (CALLBACK_URL_NATIVO) usa como
                 redirectTo — os dois lados têm de bater certo. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.futty.app" android:host="auth" />
            </intent-filter>

            <!-- Rodada 29B (bloco 3, C): links que abrem no app. Tocar em https://futtyapp.com.br/convite/…
                 (ou /equipa, /jogo) no WhatsApp abre o app e não o navegador. autoVerify: o Android confere
                 https://futtyapp.com.br/.well-known/assetlinks.json (public/.well-known/) — que precisa do
                 SHA-256 da chave de ASSINATURA DO APP do Play Console (trocar o texto SHA256_DO_PLAY_APP_SIGNING).
                 Sem o app instalado (ou sem a verificação), o link abre o site como sempre. Os caminhos daqui, os
                 do AASA do iOS e src/lib/linkDoSite.js têm de bater (há um teste). Capturado por
                 components/DeepLinkListener.jsx via appUrlOpen, como o retorno do Google acima. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="futtyapp.com.br" android:pathPrefix="/convite" />
                <data android:scheme="https" android:host="futtyapp.com.br" android:pathPrefix="/c/" />
                <data android:scheme="https" android:host="futtyapp.com.br" android:pathPrefix="/equipa" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foto da figurinha pela câmera (o upload por galeria não precisa disto). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Localização aproximada da equipa, na Explorar (nunca a pessoal — ver
         Privacidade.jsx seção 4). Os dois níveis: o Android decide sozinho qual
         diálogo mostrar conforme o que o código realmente pede em runtime. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
