<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links que abrem no app: só o link do sorteio, https://futtyapp.com.br/s/…. autoVerify: o Android confere
                 https://futtyapp.com.br/.well-known/assetlinks.json, que precisa do SHA-256 da chave de ASSINATURA DO APP do
                 Play Console. Sem o app instalado (ou sem a verificação), o link abre o site como sempre. Capturado por
                 public/ponte-nativa.js via appUrlOpen. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="futtyapp.com.br" android:pathPrefix="/s/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- O referrer da instalação (ConviteDaLojaPlugin.java) é lido de um serviço da Play Store: do Android 11 em diante o app só fala
         com o pacote que declara. Hoje a consulta do Billing já o deixa visível; aqui fica dito, para não depender dela. -->
    <queries>
        <package android:name="com.android.vending" />
    </queries>
</manifest>
