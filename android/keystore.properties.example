# Futty v2.0 — Assinatura de release do Android (14-set).
# Copie para keystore.properties (nunca commitado — ver .gitignore) e preencha
# depois de gerar a keystore com keytool ou o Android Studio:
#   keytool -genkeypair -v -keystore futty-release.jks -alias futty -keyalg RSA -keysize 2048 -validity 10000
# storeFile é relativo à pasta android/ (aqui — não à pasta app/).
storeFile=futty-release.jks
storePassword=
keyAlias=futty
keyPassword=
