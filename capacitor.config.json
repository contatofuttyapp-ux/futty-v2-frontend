{
  "appId": "com.futty.app",
  "appName": "Futty",
  "webDir": "dist",
  "backgroundColor": "#080808",
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#080808"
  },
  "ios": {
    "backgroundColor": "#080808"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#080808",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    },
    "CapacitorUpdater": {
      "autoUpdate": "atInstall",
      "autoSplashscreen": true,
      "autoSplashscreenLoader": true,
      "autoSplashscreenTimeout": 10000,
      "appId": "com.futty.app"
    }
  }
}
