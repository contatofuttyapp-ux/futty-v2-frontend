# Copia para .env e preenche com a chave pública do Supabase
VITE_SUPABASE_URL=https://ynzmjcvqdljffgbeqglh.supabase.co
# Chave PUBLISHABLE no formato novo (sb_publishable_…) — Rodada 28. Painel do Supabase →
# Project Settings → API Keys. É pública (vai dentro do app), sujeita a RLS. Nunca pôr aqui a
# chave SECRETA (sb_secret_…): essa é só do motor.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole_aqui
# Chave anon ANTIGA (JWT): só é lida se a publishable faltar. Apagar depois de desligar as
# chaves antigas no painel.
VITE_SUPABASE_ANON_KEY=a_tua_anon_public_key
# URL do backend Futty (API)
VITE_API_URL=http://localhost:3001
# Sentry (error tracking) — DSN do projecto "futty-frontend" (sentry.io)
VITE_SENTRY_DSN=https://exemplo@o000000.ingest.sentry.io/0000000
