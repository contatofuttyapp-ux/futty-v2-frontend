{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --mode network",
    "build": "vite build && node scripts/verificar-dist.js",
    "test:visibilidade": "node scripts/testar-visibilidade.mjs",
    "build:native": "npm run build && npm run test:visibilidade && node scripts/preparar-nativo.js && cap sync android",
    "build:native:ios": "npm run build && npm run test:visibilidade && node scripts/preparar-nativo.js && cap sync ios",
    "lint": "eslint .",
    "test": "node --import ./scripts/unidade/registrar.mjs --test \"scripts/unidade/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.1",
    "@sentry/react": "^10.58.0",
    "@supabase/supabase-js": "^2.107.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.40.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^7.16.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "vite": "^8.0.12"
  }
}
